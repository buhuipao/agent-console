#!/usr/bin/expect -f

set timeout 8
set root [file normalize [file join [file dirname [info script]] ../..]]
set env(AGENT_CONSOLE_CONFIG) [file join $root tests fixtures e2e-config.toml]
set env(AGENT_CONSOLE_SUMMARIZER) off
set env(CODEX_HOME) [file join $root tests fixtures e2e-codex]
set env(HOME) [file join $root tests fixtures e2e-home]
set env(PATH) "[file join $root tests fixtures bin]:$env(PATH)"
set first_fixture [file join $root tests fixtures e2e-codex sessions 2026 07 16 rollout-e2e.jsonl]
set second_fixture [file join $root tests fixtures e2e-codex sessions 2026 07 16 rollout-e2e-second.jsonl]
file mtime $first_fixture [expr {[clock seconds] - 10}]
file mtime $second_fixture [clock seconds]
set state_dir [file join /tmp "agent-console-e2e-[pid]"]
set env(AGENT_CONSOLE_STATE_DIR) $state_dir
log_user 0

proc fail {label code} {
    global spawn_id state_dir binary
    puts stderr "FAIL $label"
    flush stderr
    catch {exec kill -KILL [exp_pid -i $spawn_id]}
    catch {exec $binary pty-daemon-stop [file join $state_dir pty-daemon.sock]}
    catch {file delete -force $state_dir}
    exit $code
}

proc expect_text {pattern label code} {
    global spawn_id
    expect {
        -i $spawn_id -re $pattern {
            puts "ok $label"
            flush stdout
        }
        -i $spawn_id timeout { fail $label $code }
        -i $spawn_id eof { fail "$label (unexpected exit)" $code }
    }
}

proc provider_launches {} {
    global state_dir
    set path [file join $state_dir provider-launches]
    if {![file exists $path]} {
        return 0
    }
    set channel [open $path r]
    set launches [string length [read $channel]]
    close $channel
    return $launches
}

proc expect_text_without_alt_leave {pattern label code} {
    global spawn_id
    expect {
        -i $spawn_id -exact "\033\[?1049l" {
            fail "$label (left workspace screen)" $code
        }
        -i $spawn_id -re $pattern {
            puts "ok $label"
            flush stdout
        }
        -i $spawn_id timeout { fail $label $code }
        -i $spawn_id eof { fail "$label (unexpected exit)" $code }
    }
}

set binary [file join $root target debug agent-console]
spawn /bin/sh -c [format {stty rows 30 columns 120; exec "%s"} $binary]
set timeout 30
expect_text {Agent Console} dashboard-ready 120
set timeout 8
send -- "\r"
expect_text {FOCUS AGENT} setup 121
if {[provider_launches] != 1} { fail initial-provider-launch-count 183 }
send -- "\017"
expect_text {FOCUS SHELL 1/1} browse-setup-shell 184
send -- "\017"
expect_text {FOCUS SESSIONS} browse-setup-sessions 185
send -- "j"
expect_text_without_alt_leave {SESSION PREVIEW .*Exercise workspace controls} browse-without-dashboard 186
if {[provider_launches] != 1} { fail browse-started-provider 187 }
send -- "k"
expect_text_without_alt_leave {SESSION PREVIEW .*Verify the second dashboard session selection} browse-back-without-dashboard 188
send -- "\r"
expect_text {FOCUS AGENT} browse-activate-current 189
file mkdir [file join $state_dir events]
set event_file [file join $state_dir events codex-e2e-session.jsonl]
set event_channel [open $event_file w]
puts $event_channel {{"provider":"codex","session_id":"e2e-session","event_id":"workspace-live-refresh","timestamp":1,"kind":"approval_requested","text":"Choose the release target"}}
close $event_channel
expect_text {! Cdx Exercise wor} workspace-live-runtime 146
expect_text {ALERT .*Choose the release target} workspace-alert 147
send -- "\035"
expect_text {Exercise workspace controls} Ctrl-bracket-jump 148
send -- "\r"
expect_text {FOCUS AGENT} alert-target-agent 149
send -- "\017"
expect_text {FOCUS SHELL 1/1} Ctrl-O 122
send -- {stty -echo -icanon min 1 time 0; byte=$(/usr/bin/od -An -tx1 -N1); stty sane; echo ESC_BYTE_FORWARDED:$byte}
send -- "\r"
expect_text {ESC_BYTE_FORWARDED} esc-command-armed 198
after 100
send -- "\033"
expect_text {ESC_BYTE_FORWARDED:.*1b} Esc-forwarded-to-shell 199
send -- "\034"
expect_text {FOCUS SHELL 2/2} direct-new-shell 123
send -- "\030"
expect_text {shell is running .* again to close} direct-confirm-live 191
send -- "\030"
expect_text {FOCUS SHELL 1/1} direct-close-live 192
send -- "\034"
expect_text {FOCUS SHELL 2/2} direct-new-shell-after-close 193
send -- "\017"
expect_text {FOCUS SESSIONS} session-list-select-shell 166
send -- "1"
expect_text {selected shell 1} select-shell-1 167
send -- "\017"
expect_text {FOCUS SESSIONS} session-list-rename 168
send -- "r"
expect_text {rename shell} r-rename 168
send -- "logs\r"
expect_text {renamed shell to logs} rename-shell 169
send -- "m"
expect_text {pane maximized} maximize 170
send -- "\017"
expect_text {FOCUS SESSIONS} restore-pane 171
send -- "+"
expect_text {shell area enlarged} grow-pane 172
send -- "-"
expect_text {shell area reduced} shrink-pane 173
send -- "1"
expect_text {FOCUS SHELL 1/2} focus-command-shell 173
send -- "printf 'command-block-marker\\n'\r"
expect_text {command-block-marker} command-block-output 174
send -- "\017"
expect_text {FOCUS SESSIONS} session-list-copy 174
send -- "y"
expect_text {command block copied} command-block-copy 175
send -- "1"
expect_text {FOCUS SHELL 1/2} focus-first-shell-for-next 124
send -- "\016"
expect_text {FOCUS SHELL 2/2} direct-next-shell 124
send -- "exit 7\r"
expect_text {EXIT} shell-exit-status 176
send -- "\030"
expect_text {FOCUS SHELL 1/1} direct-close-exited-shell 125
send -- "\017"
expect_text {FOCUS SESSIONS} Ctrl-O-sessions 126
send -- "j"
expect_text {Verify the second dashboard session selection} session-list-j 177
expect_text {FOCUS SESSIONS} session-list-j-focus 178
send -- "k"
expect_text {Exercise workspace controls} session-list-k 179
expect_text {logs} session-list-shells-restored 182
send -- "x"
expect_text {SESSION ARCHIVED} session-list-archive 194
expect_text {Archived} session-list-archived-group 195
send -- "x"
expect_text {SESSION RESTORED} session-list-restore 196
expect_text {FOCUS SESSIONS} session-list-restore-focus 197
send -- "n"
expect_text {NEW SESSION} workspace-new-session 198
send -- "\r"
expect_text {FOCUS AGENT} start-workspace-new-session 199
send -- "\021"
after 200
send -- "q"
expect {
    -i $spawn_id eof {
        puts "ok Ctrl-Q"
        flush stdout
    }
    -i $spawn_id timeout { fail Ctrl-Q 127 }
}

spawn /bin/sh -c [format {stty rows 30 columns 120; exec "%s"} $binary]
expect_text {Agent Console} dashboard-ready-scroll 136
send -- "\r"
expect_text {FOCUS AGENT} scroll-setup 137
for {set i 1} {$i <= 40} {incr i} {
    send -- "agent-history-$i\r"
}
expect_text {agent-history-40} agent-scroll-output 145
send -- "\033\[<64;30;10M"
expect_text {AGENT.*SCROLL \+[1-9][0-9]*} agent-mouse-wheel 146
send -- "\033\[1;2F"
after 100
send -- "\033\[<0;22;2M"
send -- "\033\[<0;25;2m"
expect_text {selection copied} mouse-selection-copy 138
send -- "\017"
expect_text {FOCUS SHELL 1/1} scroll-shell 139
send -- "i=1; while \[ \$i -le 40 \]; do echo history-\$i; i=\$((i+1)); done\r"
expect_text {history-40} scroll-output 140
send -- "\033\[5;2~"
expect_text {SCROLL \+[1-9][0-9]*} Shift-PageUp 141
send -- "\033\[1;2F"
after 100
send -- "\033\[<64;30;23M"
expect_text {SCROLL \+[1-9][0-9]*} mouse-wheel 142
send -- "\033\[1;2F"
after 100
send -- "\033\[M`>7"
expect_text {SCROLL \+[1-9][0-9]*} legacy-mouse-wheel 145
send -- "\033\[1;2F"
after 100
send -- "printf 'live-tail-marker\\n'\r"
expect_text {live-tail-marker} Shift-End 143
send -- "\021"
after 200
send -- "q"
expect {
    -i $spawn_id eof {
        puts "ok scroll-exit"
        puts "E2E passed: direct shell controls, session creation, child passthrough, Esc, and viewport controls"
        flush stdout
    }
    -i $spawn_id timeout { fail scroll-exit 144 }
}
catch {exec $binary pty-daemon-stop [file join $state_dir pty-daemon.sock]}
catch {file delete -force $state_dir}
