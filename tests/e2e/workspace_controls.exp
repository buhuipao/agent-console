#!/usr/bin/expect -f

set timeout 8
set root [file normalize [file join [file dirname [info script]] ../..]]
set env(AGENT_CONSOLE_CONFIG) [file join $root tests fixtures e2e-config.toml]
set env(AGENT_CONSOLE_SUMMARIZER) off
set env(CODEX_HOME) [file join $root tests fixtures e2e-codex]
set env(HOME) [file join $root tests fixtures e2e-home]
set env(PATH) "[file join $root tests fixtures bin]:$env(PATH)"
set first_fixture [file join $root tests fixtures e2e-codex sessions 2026 07 16 rollout-e2e.jsonl]
set second_fixture [file join $root tests fixtures e2e-codex sessions 2026 07 16 rollout-e2e-second.jsonl]
file mtime $first_fixture [expr {[clock seconds] - 10}]
file mtime $second_fixture [clock seconds]
set state_dir [file join /tmp "agent-console-e2e-[pid]"]
set env(AGENT_CONSOLE_STATE_DIR) $state_dir
log_user 0

proc fail {label code} {
    global spawn_id state_dir binary
    puts stderr "FAIL $label"
    flush stderr
    catch {exec kill -KILL [exp_pid -i $spawn_id]}
    catch {exec $binary pty-daemon-stop [file join $state_dir pty-daemon.sock]}
    catch {file delete -force $state_dir}
    exit $code
}

proc expect_text {pattern label code} {
    global spawn_id
    expect {
        -i $spawn_id -re $pattern {
            puts "ok $label"
            flush stdout
        }
        -i $spawn_id timeout { fail $label $code }
        -i $spawn_id eof { fail "$label (unexpected exit)" $code }
    }
}

proc provider_launches {} {
    global state_dir
    set path [file join $state_dir provider-launches]
    if {![file exists $path]} {
        return 0
    }
    set channel [open $path r]
    set launches [string length [read $channel]]
    close $channel
    return $launches
}

proc clipboard_contents {} {
    global state_dir
    set path [file join $state_dir clipboard]
    if {![file exists $path]} {
        return ""
    }
    set channel [open $path r]
    set contents [read $channel]
    close $channel
    return $contents
}

proc expect_text_without_alt_leave {pattern label code} {
    global spawn_id
    expect {
        -i $spawn_id -exact "\033\[?1049l" {
            fail "$label (left workspace screen)" $code
        }
        -i $spawn_id -re $pattern {
            puts "ok $label"
            flush stdout
        }
        -i $spawn_id timeout { fail $label $code }
        -i $spawn_id eof { fail "$label (unexpected exit)" $code }
    }
}

proc expect_text_without_clear {pattern label code} {
    global spawn_id
    expect {
        -i $spawn_id -exact "\033\[2J" {
            fail "$label (remounted workspace)" $code
        }
        -i $spawn_id -re $pattern {
            puts "ok $label"
            flush stdout
        }
        -i $spawn_id timeout { fail $label $code }
        -i $spawn_id eof { fail "$label (unexpected exit)" $code }
    }
}

set binary [file join $root target debug agent-console]
spawn /bin/sh -c [format {stty rows 30 columns 120; exec "%s"} $binary]
set timeout 30
expect_text {Workspace controls are configurable} dashboard-ready 120
set timeout 8
send -- "\r"
expect_text {FOCUS AGENT} setup 121
if {[provider_launches] != 1} { fail initial-provider-launch-count 183 }
send -- "\017"
expect_text {● [0-9]+ work} workspace-status-working 210
expect_text {◐ [0-9]+ wait} workspace-status-waiting 211
expect_text {○ [0-9]+ idle} workspace-status-idle 212
expect_text {× [0-9]+ fail} workspace-status-failed 213
expect_text {FOCUS SHELL 1/1} browse-setup-shell 184
send -- "\033\[<0;5;5M\033\[<0;5;5m"
send -- "echo SIDEBAR_CLICK_SAFE\r"
expect_text {SIDEBAR_CLICK_SAFE} sidebar-click-does-not-exit 208
send -- "\033\[<0;30;1M\033\[<0;30;1m"
send -- "echo AGENT_TITLE_CLICK_SAFE\r"
expect_text {AGENT_TITLE_CLICK_SAFE} agent-title-click-does-not-exit 209
send -- "\017"
expect_text {FOCUS SESSIONS} browse-setup-sessions 185
send -- "?"
expect_text {WORKSPACE KEY BINDINGS} workspace-help-open 246
expect_text {WORKSPACE · SESSIONS} workspace-help-session-controls 247
send -- "?"
expect_text {FOCUS SESSIONS} workspace-help-key-close 248
send -- "?"
expect_text {WORKSPACE KEY BINDINGS} workspace-help-reopen 249
send -- "\033"
expect_text {FOCUS SESSIONS} workspace-help-escape-close 250
send -- "/"
expect_text {SEARCH SESSIONS} workspace-search-open 229
send -- "Exercise"
expect_text {SESSION PREVIEW .*Exercise workspace controls} workspace-search-live 230
send -- "\033"
expect_text {FOCUS SESSIONS} workspace-search-cancel-focus 231
expect_text {SESSION PREVIEW .*Verify the second dashboard session selection} workspace-search-cancel-selection 232
send -- "/"
expect_text {SEARCH SESSIONS} workspace-search-reopen 233
send -- "Exercise"
expect_text {SESSION PREVIEW .*Exercise workspace controls} workspace-search-live-again 234
send -- "\r"
expect_text_without_clear {FOCUS SESSIONS} workspace-search-commit-focus 235
expect_text {SESSION PREVIEW .*Exercise workspace controls} workspace-search-commit-selection 236
send -- "/"
expect_text {SEARCH SESSIONS} workspace-search-clear-open 237
send -- "\177\177\177\177\177\177\177\177\r"
expect_text {FOCUS SESSIONS} workspace-search-clear-commit 238
send -- "/"
expect_text {SEARCH SESSIONS} workspace-search-empty-open 240
send -- "definitely-no-match"
expect_text {No selected session} workspace-search-empty-live 241
send -- "\r"
expect_text {No selected session} workspace-search-empty-stays-in-sessions 243
expect_text {FOCUS SESSIONS} workspace-search-empty-commit 242
send -- "/"
expect_text {SEARCH SESSIONS} workspace-search-empty-clear-open 244
send -- [string repeat "\177" 19]
send -- "\r"
expect_text {FOCUS SESSIONS} workspace-search-empty-clear-commit 245
send -- "k"
expect_text_without_alt_leave {SESSION PREVIEW .*Verify the second dashboard session selection} workspace-search-restored-browse-order 239
send -- "j"
expect_text_without_alt_leave {SESSION PREVIEW .*Exercise workspace controls} browse-without-dashboard 186
if {[provider_launches] != 1} { fail browse-started-provider 187 }
send -- "h"
expect_text {AGENT .*Exercise workspace controls} h-starts-selected-agent 219
expect_text {FOCUS AGENT} h-started-agent-focuses-agent 220
if {[provider_launches] != 2} { fail h-did-not-start-selected-provider 221 }
send -- "\017"
expect_text {FOCUS SHELL 1/1} h-agent-to-shell 222
send -- "\017"
expect_text {SESSION PREVIEW .*Exercise workspace controls} h-shell-to-session-overview 223
expect_text {FOCUS SESSIONS} h-returns-to-session-focus 224
send -- "k"
expect_text_without_alt_leave {SESSION PREVIEW .*Verify the second dashboard session selection} browse-back-without-dashboard 188
send -- "\r"
expect_text {FOCUS AGENT} browse-activate-current 189
file mtime $second_fixture [expr {[clock seconds] + 5}]
after 2500
send -- "\017"
expect_text {FOCUS SHELL 1/1} stale-transcript-shell 200
send -- "\017"
expect_text {FOCUS SESSIONS} stale-transcript-sessions 201
send -- "\017"
expect_text {FOCUS AGENT} stale-transcript-ctrl-o-reactivates-agent 202
if {[provider_launches] != 2} { fail stale-transcript-ctrl-o-restarted-provider 203 }
send -- "\017"
expect_text {FOCUS SHELL 1/1} stale-transcript-shell-again 204
send -- "\017"
expect_text {FOCUS SESSIONS} stale-transcript-sessions-again 205
send -- "\r"
expect_text {FOCUS AGENT} stale-transcript-enter-reactivates-agent 206
if {[provider_launches] != 2} { fail stale-transcript-enter-restarted-provider 207 }
send -- "\004"
expect_text {FOCUS SESSIONS} ctrl-d-returns-to-session-list 225
if {[provider_launches] != 2} { fail ctrl-d-unexpected-provider-launch 226 }
send -- "\r"
expect_text {FOCUS AGENT} enter-resumes-after-ctrl-d 227
if {[provider_launches] != 3} { fail enter-did-not-resume-after-ctrl-d 228 }
file mkdir [file join $state_dir events]
set event_file [file join $state_dir events codex-e2e-session.jsonl]
set event_channel [open $event_file w]
puts $event_channel {{"provider":"codex","session_id":"e2e-session","event_id":"workspace-live-refresh","timestamp":1,"kind":"approval_requested","text":"Choose the release target"}}
close $event_channel
expect_text {! .*Cdx.*Exercise wor} workspace-live-runtime 146
expect_text {ALERT .*Choose the release target} workspace-alert 147
send -- "\035"
expect_text {Exercise workspace controls} Ctrl-bracket-jump 148
send -- "\r"
expect_text {FOCUS AGENT} alert-target-agent 149
set second_event_file [file join $state_dir events codex-e2e-session-second.jsonl]
set second_event_channel [open $second_event_file w]
puts $second_event_channel {{"provider":"codex","session_id":"e2e-session-second","event_id":"workspace-second-alert","timestamp":2,"kind":"approval_requested","text":"Second session needs attention"}}
close $second_event_channel
expect_text {ALERT .*Second session needs attention} workspace-second-alert 251
send -- "\017"
expect_text {FOCUS SHELL 1/1} alert-a-setup-shell 252
send -- "\017"
expect_text {FOCUS SESSIONS} alert-a-setup-sessions 253
send -- "a"
expect_text {Verify the second dashboard session selection} session-list-a-jump 254
send -- "\r"
expect_text {FOCUS AGENT} session-list-a-target-agent 255
send -- "\021"
expect_text {Agent Console} session-list-a-return-dashboard 256
send -- "k"
send -- "\r"
expect_text {AGENT .*Exercise workspace controls} restore-first-session-after-a 257
expect_text {FOCUS AGENT} restore-first-session-focus 258
send -- "\017"
expect_text {FOCUS SHELL 1/1} Ctrl-O 122
send -- {stty -echo -icanon min 1 time 0; byte=$(/usr/bin/od -An -tx1 -N1); stty sane; echo ESC_BYTE_FORWARDED:$byte}
send -- "\r"
expect_text {ESC_BYTE_FORWARDED} esc-command-armed 198
after 100
send -- "\033"
expect_text {ESC_BYTE_FORWARDED:.*1b} Esc-forwarded-to-shell 199
send -- "\034"
expect_text {FOCUS SHELL 2/2} direct-new-shell 123
send -- "\030"
expect_text {FOCUS SHELL 1/1} direct-close-live 191
send -- "\034"
expect_text {FOCUS SHELL 2/2} direct-new-shell-after-close 193
send -- "\017"
expect_text {FOCUS SESSIONS} session-list-select-shell 166
send -- "1"
expect_text {selected shell 1} select-shell-1 167
send -- "\017"
expect_text {FOCUS SESSIONS} session-list-layout 168
send -- "m"
expect_text {FOCUS SHELL 1/2} maximize-focuses-previous-shell 171
expect_text {shell maximized} maximize-selected-shell 170
send -- "\017"
expect_text {SESSION PREVIEW .*Exercise workspace controls} maximize-return-restores-overview 225
expect_text {FOCUS SESSIONS} maximize-return-focuses-sessions 226
send -- "h"
expect_text {AGENT .*Exercise workspace controls} live-agent-not-session-preview 217
expect_text {FOCUS AGENT} maximize-focuses-agent 215
send -- "\017"
expect_text {FOCUS SHELL 1/2} maximized-agent-to-shell 216
send -- "\017"
expect_text {SESSION PREVIEW .*Exercise workspace controls} restore-session-overview 227
expect_text {FOCUS SESSIONS} restore-session-focus 228
send -- "+"
expect_text {shell area enlarged} grow-pane 172
send -- "_"
expect_text {shell area reduced} shrink-pane 173
send -- "1"
expect_text {FOCUS SHELL 1/2} focus-command-shell 173
send -- "printf 'command-block-marker\\n'\r"
expect_text {command-block-marker} command-block-output 174
send -- "\017"
expect_text {FOCUS SESSIONS} session-list-copy 174
send -- "y"
expect_text {command block copied} command-block-copy 175
send -- "1"
expect_text {FOCUS SHELL 1/2} focus-first-shell-for-next 124
send -- "\016"
expect_text {FOCUS SHELL 2/2} direct-next-shell 124
send -- "exit 7\r"
expect_text {EXIT} shell-exit-status 176
send -- "\030"
expect_text {FOCUS SHELL 1/1} direct-close-exited-shell 125
send -- "\017"
expect_text {FOCUS SESSIONS} Ctrl-O-sessions 126
send -- "j"
expect_text {Verify the second dashboard session selection} session-list-j 177
expect_text {FOCUS SESSIONS} session-list-j-focus 178
send -- "k"
expect_text {Exercise workspace controls} session-list-k 179
expect_text {shell 1} session-list-shells-restored 182
send -- "x"
expect_text {Archived} session-list-archived-group 195
expect_text {SESSION ARCHIVED} session-list-archive 194
send -- "x"
expect_text {FOCUS SESSIONS.*SESSION RESTORED} session-list-restore-focus 197
send -- "n"
expect_text {NEW SESSION} workspace-new-session 198
send -- "\r"
expect_text {FOCUS AGENT} start-workspace-new-session 199
send -- "\021"
after 200
send -- "q"
expect {
    -i $spawn_id eof {
        puts "ok Ctrl-Q"
        flush stdout
    }
    -i $spawn_id timeout { fail Ctrl-Q 127 }
}

spawn /bin/sh -c [format {stty rows 30 columns 120; exec "%s"} $binary]
expect_text {Agent Console} dashboard-ready-scroll 136
send -- "\r"
expect_text {FOCUS AGENT} scroll-setup 137
for {set i 1} {$i <= 40} {incr i} {
    send -- "agent-history-$i\r"
}
expect_text {agent-history-40} agent-scroll-output 145
send -- "\033\[?1002h\033\[?1006h"
after 100
send -- "\033\[<64;30;10M"
expect_text {AGENT.*SCROLL \+[1-9][0-9]*} agent-mouse-wheel-with-child-reporting 146
send -- "\033\[1;2F"
after 100
send -- "\033\[?1002h\033\[?1006h"
after 100
send -- "\033\[<0;22;2M"
send -- "\033\[<32;25;2M"
send -- "\033\[<0;25;2m"
expect_text {selection copied} mouse-selection-copy 138
if {[clipboard_contents] != "agen"} { fail agent-clipboard-content 149 }
puts "ok agent-clipboard-content"
flush stdout
send -- "\017"
expect_text {FOCUS SHELL 1/1} scroll-shell 139
send -- "i=1; while \[ \$i -le 40 \]; do echo history-\$i; i=\$((i+1)); done\r"
expect_text {history-40} scroll-output 140
send -- "\033\[5;2~"
expect_text {SCROLL \+[1-9][0-9]*} Shift-PageUp 141
send -- "\033\[1;2F"
after 100
send -- "\033\[<64;30;23M"
expect_text {SCROLL \+[1-9][0-9]*} mouse-wheel 142
send -- "\033\[1;2F"
after 100
send -- "\033\[<0;22;22M"
send -- "\033\[<32;28;22M"
send -- "\033\[<0;28;22m"
expect_text {selection copied · 7 chars} shell-mouse-selection-copy 150
if {[clipboard_contents] != "history"} { fail shell-clipboard-content 151 }
puts "ok shell-clipboard-content"
flush stdout
send -- "\033\[M`>7"
expect_text {SCROLL \+[1-9][0-9]*} legacy-mouse-wheel 145
send -- "\033\[1;2F"
after 100
send -- "printf 'live-tail-marker\\n'\r"
expect_text {live-tail-marker} Shift-End 143
send -- "\021"
after 200
send -- "q"
expect {
    -i $spawn_id eof {
        puts "ok scroll-exit"
        puts "E2E passed: direct shell controls, session creation, child passthrough, Esc, and viewport controls"
        flush stdout
    }
    -i $spawn_id timeout { fail scroll-exit 144 }
}
catch {exec $binary pty-daemon-stop [file join $state_dir pty-daemon.sock]}
catch {file delete -force $state_dir}
