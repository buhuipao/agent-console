#!/usr/bin/expect -f

set timeout 45
set root [file normalize [file join [file dirname [info script]] ../..]]
if {[info exists env(AGENT_CONSOLE_TEST_BINARY)]} {
    set binary $env(AGENT_CONSOLE_TEST_BINARY)
} else {
    set binary [file join $root target debug agent-console]
}
set state_dir [file join /tmp "agent-console-real-sessions-[pid]"]
set env(AGENT_CONSOLE_STATE_DIR) $state_dir
set env(AGENT_CONSOLE_SUMMARIZER) off
set env(AGENT_CONSOLE_CONFIG) [file join $root tests fixtures real-provider-config.toml]
log_user 0

proc cleanup {} {
    global binary state_dir spawn_id
    catch {exec kill -KILL [exp_pid -i $spawn_id]}
    catch {exec $binary pty-daemon-stop [file join $state_dir pty-daemon.sock]}
    catch {file delete -force $state_dir}
}

proc fail {label code} {
    puts stderr "FAIL $label"
    flush stderr
    cleanup
    exit $code
}

proc expect_text {pattern label code} {
    global spawn_id
    expect {
        -i $spawn_id -re $pattern {
            puts "ok $label"
            flush stdout
        }
        -i $spawn_id timeout { fail $label $code }
        -i $spawn_id eof { fail "$label (unexpected exit)" $code }
    }
}

proc expect_workspace {provider_pattern label code} {
    global spawn_id
    set saw_focus 0
    set saw_provider 0
    while {!$saw_focus || !$saw_provider} {
        expect {
            -i $spawn_id -re {FOCUS AGENT} { set saw_focus 1 }
            -i $spawn_id -re $provider_pattern { set saw_provider 1 }
            -i $spawn_id timeout { fail $label $code }
            -i $spawn_id eof { fail "$label (unexpected exit)" $code }
        }
    }
    puts "ok $label"
    flush stdout
}

proc expect_codex_workspace {label code} {
    expect_workspace {OpenAI Codex|Codex CLI} "$label-provider" $code
    after 2500
    puts "ok $label"
    flush stdout
}

spawn /bin/sh -c [format {cd "%s"; stty rows 34 columns 140; exec "%s"} $root $binary]
expect_text {Agent Console} dashboard-ready 180

# Start a real Codex session, leave it through Codex's native Ctrl-D command,
# and enter it again through the provider resume contract.
send -- "n"
expect_text {NEW SESSION} codex-new-dialog 181
send -- "\r"
expect_codex_workspace codex-new-session 182
send -- "\033\[100;5u"
expect_text {FOCUS SESSIONS} codex-ctrl-d-back-to-sessions 183
send -- "\r"
expect_codex_workspace codex-resume 185
send -- "\021"
expect_text {Agent Console|SESSION OVERVIEW} codex-resume-dashboard 186

# Claude does not use Codex's native Ctrl-D exit contract. Verify that a
# retained Claude session still resumes after the daemon owner disappears.
send -- "n"
expect_text {NEW SESSION} claude-new-dialog 187
send -- "\033\[C"
send -- "\r"
expect_workspace {Claude Code|Welcome back} claude-new-session 188
after 1200
send -- "\021"
expect_text {Agent Console|SESSION OVERVIEW} claude-back-dashboard 189
after 2500
catch {exec $binary pty-daemon-stop [file join $state_dir pty-daemon.sock]}
after 300
send -- "\r"
expect_workspace {Claude Code|Welcome back} claude-resume 191
send -- "\021"
expect_text {Agent Console|SESSION OVERVIEW} claude-resume-dashboard 192
send -- "q"
expect {
    -i $spawn_id eof {
        puts "E2E passed: native Codex Ctrl-D resume and retained Claude resume lifecycle"
        flush stdout
    }
    -i $spawn_id timeout { fail real-provider-quit 193 }
}
cleanup
